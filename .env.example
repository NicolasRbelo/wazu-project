# Copie para .env e troque os valores. O .env nunca vai para o git.
API_TOKEN=troque-por-um-token-longo-e-aleatorio
DATABASE_URL=sqlite:///./alertas.db

# 127.0.0.1 só aceita conexões da própria máquina. Use o IP da interface
# do laboratório quando o Wazuh manager estiver em outra máquina/container.
API_HOST=127.0.0.1
API_PORT=8000

# Enriquecimento de IOCs. Deixe vazio para desligar a fonte.
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
CACHE_REPUTACAO_HORAS=24

# Análise por IA (Google Gemini). Sem chave, a análise responde 503.
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash

# Feedback dos analistas que a IA usa como referência (fica fora do git).
FEEDBACK_ARQUIVO=dados/feedback_ia.json

# Alertas do mesmo IP (ou da mesma regra no mesmo agente) com menos que isto entre si
# viram um incidente só, decidido de uma vez.
INCIDENTE_JANELA_MINUTOS=30

# Resposta ativa: bloquear o IP no agente atacado (firewall-drop), só com aprovação do analista.
# Sem URL, o botão de bloqueio responde 503. No laboratório (wazuh-docker), o certificado é
# próprio: WAZUH_API_VERIFICAR_TLS=false. Fora do laboratório, mantenha true.
WAZUH_API_URL=
WAZUH_API_USUARIO=
WAZUH_API_SENHA=
WAZUH_API_VERIFICAR_TLS=true
BLOQUEIO_PROTEGIDOS=
